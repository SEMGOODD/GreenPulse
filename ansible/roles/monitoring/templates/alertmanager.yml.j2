# {{ ansible_managed }}
# WHERE the alerts go. Prometheus decides WHEN an alert fires (rules/),
# Alertmanager decides WHO is told, groups related alerts and avoids spam.
#
# Discord is enabled as soon as vault_discord_webhook_url exists in the vault:
#   ansible-vault edit group_vars/all/vault.yml
#   vault_discord_webhook_url: "https://discord.com/api/webhooks/..."
# Without it, alerts are only visible in the Alertmanager UI (port 9093).

route:
  receiver: {{ 'discord' if vault_discord_webhook_url is defined else '"null"' }}
  # Alerts with the same name are sent in ONE message (e.g. 3 targets down).
  group_by: [alertname]
  group_wait: 30s       # wait a bit to group alerts that fire together
  group_interval: 5m    # then send new alerts of the group at most every 5 min
  repeat_interval: 4h   # remind every 4 h while it is still firing
  routes:
    # Greenhouse anomalies come and go often: remind less frequently.
    - matchers: ['severity="info"']
      receiver: {{ 'discord' if vault_discord_webhook_url is defined else '"null"' }}
      repeat_interval: 12h

receivers:
  - name: "null"
{% if vault_discord_webhook_url is defined %}
  - name: discord
    discord_configs:
      - webhook_url: "{{ vault_discord_webhook_url }}"
        send_resolved: true
{% raw %}
        # Go templates (Alertmanager), protected from Jinja by "raw".
        title: '{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} {{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})'
        message: |-
          {{ range .Alerts }}{{ if eq .Status "firing" }}• {{ .Annotations.summary }}{{ else }}• resolved: {{ .Annotations.summary }}{{ end }}
          {{ end }}
{% endraw %}
{% endif %}

# While a VM is down, do not also send the alerts of the services on it.
inhibit_rules:
  - source_matchers: ['alertname="InstanceDown"', 'job="node"']
    target_matchers: ['severity=~"warning|info"']
    equal: [vm]
