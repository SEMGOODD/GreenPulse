# {{ ansible_managed }}
# ============================================================================
# Tells Prometheus WHAT to scrape and WHERE.
# Ansible fills the {{ '{{ ... }}' }} variables (the private IPs come from the
# inventory generated by Terraform) and validates the result with promtool.
# ============================================================================

global:
  scrape_interval: {{ monitoring_scrape_interval }}
  evaluation_interval: {{ monitoring_scrape_interval }}

# Where to send the alerts that fire (the Alertmanager container).
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

# Your alert rules (files/rules/*.yml).
rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  # Prometheus scrapes itself. Already done: use it as a model.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # System metrics (node_exporter) on the 3 VMs. The "vm" label gives each
  # target a readable name in Grafana instead of an IP address.
  - job_name: node
    static_configs:
      - targets: ["{{ app_private_ip }}:9100"]
        labels:
          vm: app
      - targets: ["{{ bdd_private_ip }}:9100"]
        labels:
          vm: bdd
{% if monitoring_private_ip is defined %}
      - targets: ["{{ monitoring_private_ip }}:9100"]
        labels:
          vm: monitoring
{% endif %}

  # PostgreSQL metrics (postgres_exporter) on the BDD VM.
  - job_name: postgres
    static_configs:
      - targets: ["{{ bdd_private_ip }}:9187"]
        labels:
          vm: bdd

  # The GreenPulse services on the APP VM: one job per service, so that
  # job="ingest-api" (for example) selects one service in every query.
  - job_name: alert-worker
    static_configs:
      - targets: ["{{ app_private_ip }}:9101"]
        labels:
          vm: app

  - job_name: ingest-api
    static_configs:
      - targets: ["{{ app_private_ip }}:9102"]
        labels:
          vm: app

  - job_name: query-api
    static_configs:
      - targets: ["{{ app_private_ip }}:9103"]
        labels:
          vm: app
