# {{ ansible_managed }}
DB_HOST={{ app_db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD='{{ db_password }}'
HELLO_TABLE={{ app_hello_table }}
APP_PORT={{ app_port }}
# Metrics ports are published on the private IP only (scraped by Prometheus).
METRICS_HOST_IP={{ app_private_ip }}
IMAGE_REGISTRY= {{ app_image_registry }}
IMAGE_TAG= {{ app_image_tag }}
SENSOR_IDS={{ app_sensor_ids | join(',') }}
{% for name, value in app_thresholds.items() %}
{{ name }}={{ value }}
{% endfor %}
