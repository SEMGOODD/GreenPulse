# {{ ansible_managed }}
[Unit]
Description=GreenPulse FastAPI application
After=network-online.target
Wants=network-online.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_env_file }}
ExecStart={{ app_venv_dir }}/bin/uvicorn main:app --host {{ app_host }} --port {{ app_port }}
Restart=on-failure
RestartSec=3

# Sandboxing: the service sees a read-only system and no home directories.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
