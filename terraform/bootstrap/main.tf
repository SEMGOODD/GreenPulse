# Bucket names are global to all AWS customers: the account ID makes ours unique.
data "aws_caller_identity" "current" {}

resource "aws_s3_bucket" "tfstate" {
  bucket        = "${var.project_name}-tfstate-${data.aws_caller_identity.current.account_id}"
  force_destroy = var.force_destroy
}

# Keeps every previous version of the state: a broken state can be restored.
resource "aws_s3_bucket_versioning" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id

  versioning_configuration {
    status = "Enabled"
  }
}

# The state contains sensitive values (IPs, resource IDs, sometimes secrets).
resource "aws_s3_bucket_server_side_encryption_configuration" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "tfstate" {
  bucket = aws_s3_bucket.tfstate.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# A backend block cannot use variables, so the bucket settings are written to
# a file that the main configuration loads with:
#   terraform init -backend-config=backend.hcl
resource "local_file" "backend_config" {
  filename        = "${path.module}/../backend.hcl"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by terraform/bootstrap. Do not edit by hand.
    bucket       = "${aws_s3_bucket.tfstate.id}"
    key          = "${var.state_key}"
    region       = "${var.aws_region}"
    profile      = "${var.aws_profile}"
    encrypt      = true
    use_lockfile = true
  EOT
}
